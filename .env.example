# .env.example
# Copy to .env and fill with **your** real values. Do NOT commit .env.

# --- MySQL / SQLAlchemy ---
# Format: mysql+pymysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME
MYSQL_URL="mysql+pymysql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:3306/hardware"

# --- SSH defaults ---
SSH_DEFAULT_USERNAME="your_ssh_username_here"
SSH_DEFAULT_PASSWORD="your_ssh_password_here"

# --- Optional: multiple credentials as JSON list ---
# Example:
# CREDENTIALS_JSON='[{"device_type":"huawei","username":"h_user","password":"h_pass","command":"display version"}]'
CREDENTIALS_JSON='[]'

# --- Devices list ---
# Path to a text file with IPs (one per line). If missing, DEVICES env var is used.
DEVICES_CSV="devices.txt"
# Or comma/newline separated list of IPs:
DEVICES="10.0.0.1,10.0.0.2"

# --- Local paths ---
HOSTNAME_INPUT_DIR="D:/Network_Database/Hostname"
OUTPUT_DIR="./output"

# --- Optional logging level ---
LOG_LEVEL="INFO"
